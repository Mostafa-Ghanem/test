# ---------- App (Vercel / local) ----------
DATABASE_URL=postgres://privatecall:privatecall@localhost:5432/privatecall
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# First admin, created by `npm run db:migrate` if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now-please

# true = simulated calls only (no Asterisk / provider needed)
DEMO_MODE=true

# ---------- Dialing policy / abuse protection ----------
ALLOWED_COUNTRY_CODES=20
BLOCKED_PREFIXES=+20900,+44870,+44871,+44872,+449
DEFAULT_COUNTRY=EG
NEXT_PUBLIC_DEFAULT_DIAL_PREFIX=+20
CALLS_PER_MINUTE=5
PROVIDER_RATE_PER_MINUTE=0.02

# ---------- Voice server (Asterisk VM) ----------
VOICE_WSS_URL=wss://voice.example.com:8089/ws
VOICE_SIP_DOMAIN=voice.example.com
VOICE_HEALTH_URL=https://voice.example.com:8089/httpstatus
# Shared secret between Asterisk and the app (>=16 chars). Same value on the VM.
VOICE_SHARED_SECRET=
# Derives per-extension WebRTC SIP passwords (never stored in DB)
SIP_EXTENSION_SECRET=
# coturn static-auth-secret (same value in turnserver.conf)
TURN_SECRET=
TURN_URLS=turn:voice.example.com:3478?transport=udp,turns:voice.example.com:5349?transport=tcp
STUN_URLS=stun:voice.example.com:3478

# ---------- Upstream SIP provider (swap = change these only) ----------
# localphone | telnyx | generic-sip
SIP_PROVIDER=
SIP_HOST=
SIP_PORT=
SIP_TRANSPORT=udp
SIP_USERNAME=
SIP_PASSWORD=
# Account-owned number, sent only in P-Asserted-Identity with Privacy: id. Never user-supplied.
SIP_FROM_NUMBER=
SIP_PRIVACY_ENABLED=true
# e164 (+2010...) | digits (2010...) | intl00 (002010...)
SIP_DIAL_FORMAT=
SIP_DIAL_PREFIX=
SIP_REGISTER=
